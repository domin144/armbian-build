diff --git a/drivers/net/wireless/realtek/rtw88/rx.c b/drivers/net/wireless/realtek/rtw88/rx.c
index 111111111111..222222222222 100644
--- a/drivers/net/wireless/realtek/rtw88/rx.c
+++ b/drivers/net/wireless/realtek/rtw88/rx.c
@@ -306,3 +306,50 @@ void rtw_rx_query_rx_desc(struct rtw_dev *rtwdev, void *rx_desc8,
 	rtw_rx_fill_rx_status(rtwdev, pkt_stat, hdr, rx_status);
 }
 EXPORT_SYMBOL(rtw_rx_query_rx_desc);
+
+void rtw_rx_skb(struct rtw_dev *rtwdev, struct sk_buff *skb, u8 pkt_alignment)
+{
+	const struct rtw_chip_info *chip = rtwdev->chip;
+	u32 pkt_offset, next_pkt, bytes_remaining;
+	u32 pkt_desc_sz = chip->rx_pkt_desc_sz;
+	struct ieee80211_rx_status rx_status;
+	struct rtw_rx_pkt_stat pkt_stat;
+	struct sk_buff *next_skb;
+	u8 *rx_desc;
+
+	bytes_remaining = skb->len;
+
+	do {
+		rx_desc = skb->data;
+		rtw_rx_query_rx_desc(rtwdev, rx_desc, &pkt_stat, &rx_status);
+		pkt_offset = pkt_desc_sz + pkt_stat.drv_info_sz + pkt_stat.shift;
+
+		next_pkt = round_up(pkt_stat.pkt_len + pkt_offset,
+				    pkt_alignment);
+
+		if (bytes_remaining >= next_pkt + pkt_desc_sz)
+			next_skb = skb_clone(skb, GFP_KERNEL);
+		else
+			next_skb = NULL;
+
+		if (pkt_stat.is_c2h) {
+			skb_trim(skb, pkt_stat.pkt_len + pkt_offset);
+			rtw_fw_c2h_cmd_rx_irqsafe(rtwdev, pkt_offset, skb);
+		} else {
+			skb_pull(skb, pkt_offset);
+			skb_trim(skb, pkt_stat.pkt_len);
+			rtw_update_rx_freq_for_invalid(rtwdev, skb, &rx_status,
+						       &pkt_stat);
+			rtw_rx_stats(rtwdev, pkt_stat.vif, skb);
+			memcpy(skb->cb, &rx_status, sizeof(rx_status));
+			ieee80211_rx_irqsafe(rtwdev->hw, skb);
+		}
+
+		skb = next_skb;
+		if (skb)
+			skb_pull(skb, next_pkt);
+
+		bytes_remaining -= next_pkt;
+	} while (skb);
+}
+EXPORT_SYMBOL(rtw_rx_skb);
